<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Job Finder — Find Your Dream Job</title>
<style>
  :root{
    --navy:#0f2540;
    --navy-2:#16345c;
    --teal:#0d9488;
    --teal-light:#ccfbf1;
    --amber:#f59e0b;
    --bg:#f6f8fb;
    --card:#ffffff;
    --text:#1b2735;
    --muted:#5b6b7c;
    --border:#e4e9f0;
    --radius:14px;
    --shadow:0 4px 16px rgba(15,37,64,0.08);
    --shadow-hover:0 10px 28px rgba(15,37,64,0.14);
  }

  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Segoe UI',Roboto,-apple-system,BlinkMacSystemFont,Arial,sans-serif;
    background:var(--bg);
    color:var(--text);
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  img,svg{display:block;}
  a{text-decoration:none;color:inherit;}
  ul{list-style:none;}
  button{font-family:inherit;cursor:pointer;border:none;background:none;}
  .container{max-width:1180px;margin:0 auto;padding:0 24px;}
  section{padding:70px 0;}
  .section-head{text-align:center;max-width:640px;margin:0 auto 42px;}
  .eyebrow{
    display:inline-block;color:var(--teal);font-weight:700;font-size:0.78rem;
    letter-spacing:1.5px;text-transform:uppercase;margin-bottom:10px;
  }
  .section-head h2{font-size:2rem;color:var(--navy);margin-bottom:10px;}
  .section-head p{color:var(--muted);font-size:1rem;}

  /* ---------- NAVBAR ---------- */
  header{
    position:sticky;top:0;z-index:1000;
    background:rgba(255,255,255,0.92);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--border);
  }
  .navbar{
    display:flex;align-items:center;justify-content:space-between;
    max-width:1180px;margin:0 auto;padding:16px 24px;
  }
  .logo{
    display:flex;align-items:center;gap:8px;
    font-size:1.35rem;font-weight:800;color:var(--navy);
  }
  .logo-mark{
    width:34px;height:34px;border-radius:9px;
    background:linear-gradient(135deg,var(--teal),var(--navy));
    display:flex;align-items:center;justify-content:center;
    color:#fff;font-size:1.05rem;font-weight:800;
  }
  .nav-links{display:flex;gap:6px;align-items:center;}
  .nav-links a{
    padding:9px 16px;border-radius:8px;font-weight:600;font-size:0.95rem;
    color:var(--navy-2);transition:background .2s, color .2s;
  }
  .nav-links a:hover, .nav-links a.active{background:var(--teal-light);color:var(--teal);}
  .saved-count{
    background:var(--amber);color:#fff;border-radius:50%;
    font-size:0.68rem;font-weight:800;min-width:17px;height:17px;
    display:inline-flex;align-items:center;justify-content:center;
    margin-left:6px;padding:0 4px;
  }
  .hamburger{
    display:none;flex-direction:column;gap:5px;padding:6px;
  }
  .hamburger span{width:24px;height:2.5px;background:var(--navy);border-radius:2px;transition:.3s;}
  .hamburger.open span:nth-child(1){transform:translateY(7.5px) rotate(45deg);}
  .hamburger.open span:nth-child(2){opacity:0;}
  .hamburger.open span:nth-child(3){transform:translateY(-7.5px) rotate(-45deg);}

  /* ---------- HERO ---------- */
  .hero{
    background:linear-gradient(160deg,var(--navy) 0%, var(--navy-2) 55%, #124a63 100%);
    color:#fff;padding:76px 0 90px;position:relative;overflow:hidden;
  }
  .hero::before{
    content:"";position:absolute;top:-120px;right:-120px;width:420px;height:420px;
    border-radius:50%;background:radial-gradient(circle,rgba(13,148,136,0.35),transparent 70%);
  }
  .hero-inner{
    display:grid;grid-template-columns:1.1fr 0.9fr;gap:48px;align-items:center;
    position:relative;z-index:1;
  }
  .hero-text .eyebrow{color:var(--amber);}
  .hero-text h1{font-size:2.7rem;line-height:1.15;margin-bottom:16px;font-weight:800;}
  .hero-text h1 span{color:var(--teal-light);}
  .hero-text p{color:#cbd8e6;font-size:1.05rem;max-width:480px;margin-bottom:30px;}

  .search-box{
    background:#fff;border-radius:16px;padding:16px;box-shadow:0 18px 40px rgba(0,0,0,0.25);
    display:grid;grid-template-columns:1.3fr 1fr auto;gap:10px;
  }
  .search-field{
    display:flex;align-items:center;gap:8px;border:1px solid var(--border);
    border-radius:10px;padding:11px 14px;background:#fbfcfe;
  }
  .search-field .ic{color:var(--teal);font-size:1.05rem;}
  .search-field input{
    border:none;outline:none;background:transparent;width:100%;font-size:0.95rem;color:var(--text);
  }
  .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:6px;
    padding:11px 20px;border-radius:10px;font-weight:700;font-size:0.95rem;
    transition:transform .15s, box-shadow .15s, background .2s;
    white-space:nowrap;
  }
  .btn-primary{background:var(--teal);color:#fff;box-shadow:0 6px 16px rgba(13,148,136,0.35);}
  .btn-primary:hover{background:#0b7c72;transform:translateY(-1px);}
  .btn-outline{background:transparent;border:1.5px solid var(--border);color:var(--navy);}
  .btn-outline:hover{border-color:var(--teal);color:var(--teal);}
  .btn-sm{padding:8px 14px;font-size:0.85rem;border-radius:8px;}
  .btn-block{width:100%;}

  .hero-art{position:relative;height:340px;display:flex;align-items:center;justify-content:center;}
  .hero-card{
    position:absolute;background:#fff;border-radius:14px;box-shadow:0 14px 30px rgba(0,0,0,0.25);
    padding:14px 16px;color:var(--text);width:200px;
  }
  .hero-card h4{font-size:0.85rem;color:var(--navy);margin-bottom:2px;}
  .hero-card p{font-size:0.72rem;color:var(--muted);margin:0;}
  .hero-card.c1{top:0;left:10px;transform:rotate(-6deg);animation:float1 5s ease-in-out infinite;}
  .hero-card.c2{bottom:20px;right:0;transform:rotate(4deg);animation:float2 6s ease-in-out infinite;}
  .hero-card.c3{top:120px;right:60px;transform:rotate(-3deg);animation:float1 7s ease-in-out infinite;}
  .hero-badge{
    width:190px;height:190px;border-radius:50%;
    background:conic-gradient(from 180deg, var(--teal), var(--amber), var(--teal-light), var(--teal));
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 20px 50px rgba(0,0,0,0.3);
  }
  .hero-badge-inner{
    width:150px;height:150px;border-radius:50%;background:var(--navy-2);
    display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;text-align:center;
  }
  .hero-badge-inner strong{font-size:1.6rem;}
  .hero-badge-inner span{font-size:0.72rem;color:#cbd8e6;}
  @keyframes float1{0%,100%{transform:translateY(0) rotate(-6deg);}50%{transform:translateY(-12px) rotate(-3deg);}}
  @keyframes float2{0%,100%{transform:translateY(0) rotate(4deg);}50%{transform:translateY(-10px) rotate(7deg);}}

  /* ---------- STATS ---------- */
  .stats{background:#fff;border-bottom:1px solid var(--border);padding:44px 0;}
  .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;text-align:center;}
  .stat h3{font-size:2rem;color:var(--navy);font-weight:800;}
  .stat span{color:var(--muted);font-size:0.9rem;font-weight:600;}

  /* ---------- FILTER BAR ---------- */
  .filter-bar{
    background:var(--card);border:1px solid var(--border);border-radius:var(--radius);
    padding:18px;display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr auto;gap:12px;
    box-shadow:var(--shadow);margin-bottom:34px;
  }
  .filter-bar select, .filter-bar input{
    width:100%;padding:10px 12px;border:1px solid var(--border);border-radius:9px;
    font-size:0.9rem;color:var(--text);background:#fbfcfe;outline:none;
  }
  .filter-bar select:focus, .filter-bar input:focus{border-color:var(--teal);}
  .results-info{
    display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;flex-wrap:wrap;gap:10px;
  }
  .results-info p{color:var(--muted);font-size:0.92rem;}
  .clear-link{color:var(--teal);font-weight:700;font-size:0.88rem;}

  /* ---------- JOB GRID ---------- */
  .job-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;}
  .job-card{
    background:var(--card);border:1px solid var(--border);border-radius:var(--radius);
    padding:22px;box-shadow:var(--shadow);transition:transform .2s, box-shadow .2s;cursor:pointer;
    position:relative;display:flex;flex-direction:column;gap:12px;
  }
  .job-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-hover);}
  .job-card-top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;}
  .job-logo{
    width:46px;height:46px;border-radius:10px;flex-shrink:0;
    display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:1.1rem;
  }
  .job-title{font-size:1.08rem;color:var(--navy);font-weight:700;}
  .job-company{color:var(--muted);font-size:0.88rem;font-weight:600;}
  .save-btn{
    font-size:1.25rem;color:#c8d0da;transition:color .2s, transform .2s;line-height:1;flex-shrink:0;
  }
  .save-btn.saved{color:#e11d48;}
  .save-btn:hover{transform:scale(1.15);}
  .job-meta{display:flex;flex-wrap:wrap;gap:8px;}
  .tag{
    font-size:0.74rem;font-weight:700;padding:5px 10px;border-radius:20px;
    background:var(--teal-light);color:#0b7c72;
  }
  .tag.loc{background:#eef2ff;color:#4338ca;}
  .tag.exp{background:#fff7ed;color:#c2410c;}
  .job-desc{color:var(--muted);font-size:0.87rem;flex-grow:1;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
  .job-card-bottom{display:flex;justify-content:space-between;align-items:center;margin-top:4px;}
  .job-salary{font-weight:800;color:var(--navy);font-size:0.95rem;}

  .no-results{
    grid-column:1/-1;text-align:center;padding:60px 20px;color:var(--muted);
    background:#fff;border-radius:var(--radius);border:1px dashed var(--border);
  }
  .no-results .ic{font-size:2.6rem;margin-bottom:10px;}
  .no-results h3{color:var(--navy);margin-bottom:6px;}

  /* ---------- CATEGORIES ---------- */
  .cat-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:18px;}
  .cat-card{
    background:var(--card);border:1px solid var(--border);border-radius:var(--radius);
    padding:26px 16px;text-align:center;box-shadow:var(--shadow);transition:transform .2s, box-shadow .2s;
  }
  .cat-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-hover);}
  .cat-icon{
    width:56px;height:56px;border-radius:14px;margin:0 auto 14px;
    display:flex;align-items:center;justify-content:center;font-size:1.5rem;
  }
  .cat-card h4{font-size:0.95rem;color:var(--navy);margin-bottom:4px;}
  .cat-card span{font-size:0.8rem;color:var(--muted);}

  /* ---------- ABOUT ---------- */
  .about{background:#fff;}
  .about-inner{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;}
  .about-visual{
    height:280px;border-radius:20px;
    background:linear-gradient(135deg,var(--navy),var(--teal));
    position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;
  }
  .about-visual .ring{position:absolute;border:2px solid rgba(255,255,255,0.25);border-radius:50%;}
  .about-visual .ring.r1{width:340px;height:340px;}
  .about-visual .ring.r2{width:240px;height:240px;}
  .about-visual span{color:#fff;font-size:3.2rem;font-weight:800;position:relative;z-index:1;}
  .about-text h2{font-size:1.9rem;color:var(--navy);margin-bottom:14px;}
  .about-text p{color:var(--muted);margin-bottom:14px;}
  .about-points{display:flex;flex-direction:column;gap:10px;margin-top:16px;}
  .about-points li{display:flex;gap:10px;align-items:flex-start;color:var(--text);font-size:0.94rem;}
  .about-points .ic{color:var(--teal);font-weight:800;}

  /* ---------- SAVED SECTION ---------- */
  .saved-empty{
    text-align:center;padding:50px 20px;color:var(--muted);background:#fff;
    border-radius:var(--radius);border:1px dashed var(--border);
  }
  .saved-empty .ic{font-size:2.4rem;margin-bottom:10px;}

  /* ---------- FOOTER ---------- */
  footer{background:var(--navy);color:#cbd8e6;padding:56px 0 24px;}
  .footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:36px;padding-bottom:36px;border-bottom:1px solid rgba(255,255,255,0.12);}
  .footer-logo{display:flex;align-items:center;gap:8px;font-size:1.25rem;font-weight:800;color:#fff;margin-bottom:12px;}
  .footer-col h4{color:#fff;font-size:0.95rem;margin-bottom:14px;}
  .footer-col ul li{margin-bottom:9px;font-size:0.9rem;}
  .footer-col ul li a:hover{color:var(--teal-light);}
  .footer-bottom{
    display:flex;justify-content:space-between;align-items:center;padding-top:22px;font-size:0.82rem;
    flex-wrap:wrap;gap:8px;
  }

  /* ---------- MODAL ---------- */
  .modal-overlay{
    position:fixed;inset:0;background:rgba(10,20,35,0.55);backdrop-filter:blur(3px);
    display:none;align-items:center;justify-content:center;z-index:2000;padding:20px;
  }
  .modal-overlay.active{display:flex;}
  .modal{
    background:#fff;border-radius:18px;max-width:560px;width:100%;max-height:88vh;overflow-y:auto;
    padding:30px;position:relative;box-shadow:0 30px 60px rgba(0,0,0,0.35);
    animation:pop .22s ease;
  }
  @keyframes pop{from{transform:scale(0.94);opacity:0;}to{transform:scale(1);opacity:1;}}
  .modal-close{
    position:absolute;top:18px;right:18px;font-size:1.3rem;color:var(--muted);
    width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;
    transition:background .2s;
  }
  .modal-close:hover{background:var(--bg);}
  .modal-head{display:flex;gap:14px;align-items:center;margin-bottom:18px;padding-right:30px;}
  .modal-head h2{font-size:1.35rem;color:var(--navy);}
  .modal-head p{color:var(--muted);font-size:0.9rem;}
  .modal-meta{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px;}
  .modal-block{margin-bottom:16px;}
  .modal-block h4{font-size:0.85rem;color:var(--navy);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;}
  .modal-block p, .modal-block li{color:var(--muted);font-size:0.92rem;}
  .modal-block ul{padding-left:18px;list-style:disc;}
  .modal-salary-row{
    display:flex;justify-content:space-between;align-items:center;background:var(--bg);
    padding:14px 16px;border-radius:12px;margin-bottom:18px;
  }
  .modal-salary-row strong{color:var(--navy);font-size:1.15rem;}
  .modal-actions{display:flex;gap:10px;}

  /* ---------- TOAST ---------- */
  .toast-wrap{position:fixed;bottom:24px;right:24px;z-index:3000;display:flex;flex-direction:column;gap:10px;}
  .toast{
    background:var(--navy);color:#fff;padding:13px 18px;border-radius:10px;font-size:0.9rem;font-weight:600;
    box-shadow:0 10px 26px rgba(0,0,0,0.25);display:flex;align-items:center;gap:8px;
    animation:slideIn .25s ease, fadeOut .3s ease 2.4s forwards;min-width:220px;
  }
  .toast.success{background:#0d9488;}
  .toast.error{background:#dc2626;}
  @keyframes slideIn{from{transform:translateX(40px);opacity:0;}to{transform:translateX(0);opacity:1;}}
  @keyframes fadeOut{to{opacity:0;transform:translateX(20px);}}

  /* ---------- RESPONSIVE ---------- */
  @media (max-width:980px){
    .hero-inner{grid-template-columns:1fr;}
    .hero-art{height:240px;order:-1;}
    .job-grid{grid-template-columns:1fr;}
    .about-inner{grid-template-columns:1fr;}
    .cat-grid{grid-template-columns:repeat(3,1fr);}
    .stats-grid{grid-template-columns:repeat(2,1fr);}
    .footer-grid{grid-template-columns:1fr 1fr;}
  }
  @media (max-width:760px){
    .nav-links{
      position:absolute;top:100%;left:0;right:0;background:#fff;flex-direction:column;
      align-items:stretch;padding:10px 20px 18px;border-bottom:1px solid var(--border);
      display:none;box-shadow:0 12px 20px rgba(0,0,0,0.06);
    }
    .nav-links.open{display:flex;}
    .nav-links a{padding:12px 10px;}
    .hamburger{display:flex;}
    .search-box{grid-template-columns:1fr;}
    .filter-bar{grid-template-columns:1fr 1fr;}
    .filter-bar .btn{grid-column:1/-1;}
    .hero-text h1{font-size:2.1rem;}
    .footer-grid{grid-template-columns:1fr;}
  }
  @media (max-width:520px){
    .cat-grid{grid-template-columns:repeat(2,1fr);}
    .stats-grid{grid-template-columns:1fr 1fr;}
    .job-card-top{flex-wrap:wrap;}
  }
</style>
</head>
<body>

<!-- ===== NAVBAR ===== -->
<header>
  <nav class="navbar">
    <a href="#home" class="logo"><span class="logo-mark">JF</span> Job Finder</a>
    <ul class="nav-links" id="navLinks">
      <li><a href="#home" class="nav-link active">Home</a></li>
      <li><a href="#jobs" class="nav-link">Find Jobs</a></li>
      <li><a href="#saved" class="nav-link">Saved Jobs <span class="saved-count" id="savedCountNav">0</span></a></li>
      <li><a href="#about" class="nav-link">About</a></li>
    </ul>
    <button class="hamburger" id="hamburger" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
  </nav>
</header>

<!-- ===== HERO ===== -->
<section class="hero" id="home">
  <div class="container hero-inner">
    <div class="hero-text">
      <span class="eyebrow">10,000+ Job Seekers Trust Us</span>
      <h1>Find Your <span>Dream Job</span> Today</h1>
      <p>Search thousands of curated openings from top companies. Filter by role, location and experience to land the opportunity that fits your career goals.</p>

      <form class="search-box" id="heroSearchForm">
        <div class="search-field">
          <span class="ic">🔍</span>
          <input type="text" id="heroKeyword" placeholder="Job title or keyword (e.g. Web Developer)">
        </div>
        <div class="search-field">
          <span class="ic">📍</span>
          <input type="text" id="heroLocation" placeholder="Location (e.g. Remote)">
        </div>
        <button type="submit" class="btn btn-primary">Search Jobs</button>
      </form>
    </div>

    <div class="hero-art">
      <div class="hero-badge">
        <div class="hero-badge-inner">
          <strong id="totalJobsBadge">10+</strong>
          <span>Open Roles</span>
        </div>
      </div>
      <div class="hero-card c1">
        <h4>✅ Application Sent</h4>
        <p>UI/UX Designer · Pixelworks</p>
      </div>
      <div class="hero-card c2">
        <h4>💼 New Match</h4>
        <p>Data Analyst · InsightIQ</p>
      </div>
      <div class="hero-card c3">
        <h4>⭐ Top Rated</h4>
        <p>Company · 4.8/5</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== STATS ===== -->
<section class="stats">
  <div class="container stats-grid">
    <div class="stat"><h3>500+</h3><span>Jobs</span></div>
    <div class="stat"><h3>100+</h3><span>Companies</span></div>
    <div class="stat"><h3>50+</h3><span>Categories</span></div>
    <div class="stat"><h3>10K+</h3><span>Job Seekers</span></div>
  </div>
</section>

<!-- ===== FIND JOBS ===== -->
<section id="jobs">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Browse Openings</span>
      <h2>Find Jobs That Fit You</h2>
      <p>Use search and filters to narrow down the perfect opportunity.</p>
    </div>

    <div class="filter-bar">
      <div class="search-field" style="background:#fbfcfe;">
        <span class="ic">🔍</span>
        <input type="text" id="filterKeyword" placeholder="Search by title or keyword">
      </div>
      <select id="filterType">
        <option value="">All Job Types</option>
        <option>Full-time</option>
        <option>Part-time</option>
        <option>Internship</option>
        <option>Remote</option>
        <option>Contract</option>
      </select>
      <select id="filterLocation">
        <option value="">All Locations</option>
      </select>
      <select id="filterExperience">
        <option value="">All Experience</option>
        <option>Fresher</option>
        <option>0-1 years</option>
        <option>1-3 years</option>
        <option>2-4 years</option>
        <option>3-5 years</option>
        <option>5+ years</option>
      </select>
      <button class="btn btn-outline" id="resetFilters">Reset</button>
    </div>

    <div class="results-info">
      <p id="resultsCount">Showing 10 jobs</p>
      <a href="#" class="clear-link" id="clearAllLink">Clear all filters</a>
    </div>

    <div class="job-grid" id="jobGrid"></div>
  </div>
</section>

<!-- ===== POPULAR CATEGORIES ===== -->
<section style="background:#fff;">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Explore</span>
      <h2>Popular Categories</h2>
      <p>Jump straight into the field you're most interested in.</p>
    </div>
    <div class="cat-grid" id="categoryGrid"></div>
  </div>
</section>

<!-- ===== SAVED JOBS ===== -->
