<!-- ===== TOAST CONTAINER ===== -->
<div class="toast-wrap" id="toastWrap"></div>

<script>
(function(){
  "use strict";

  /* ---------------- SAMPLE DATA ---------------- */
  const jobs = [
    {
      id:1, title:"Frontend Web Developer", company:"CodeNova Technologies", location:"Bengaluru",
      type:"Full-time", experience:"1-3 years", salary:"₹6,00,000 - ₹9,00,000 / yr", color:"#0d9488",
      desc:"Build responsive, high-performance web interfaces using HTML, CSS and JavaScript frameworks.",
      responsibilities:["Develop and maintain responsive UI components","Collaborate with designers to implement pixel-perfect layouts","Optimize applications for speed and scalability","Write clean, reusable, well-documented code"],
      requirements:["Strong knowledge of HTML, CSS, JavaScript","Familiarity with React or Vue is a plus","Understanding of responsive design principles","Good problem-solving skills"]
    },
    {
      id:2, title:"UI/UX Designer", company:"Pixelworks Studio", location:"Remote",
      type:"Full-time", experience:"2-4 years", salary:"₹5,50,000 - ₹8,50,000 / yr", color:"#7c3aed",
      desc:"Design intuitive and visually appealing user experiences for web and mobile products.",
      responsibilities:["Create wireframes, prototypes and high-fidelity mockups","Conduct user research and usability testing","Maintain and evolve design systems","Work closely with developers during implementation"],
      requirements:["Proficiency in Figma or Adobe XD","Strong portfolio of UI/UX projects","Understanding of accessibility standards","Excellent visual and communication skills"]
    },
    {
      id:3, title:"Content Writer", company:"BrightPage Media", location:"Kolkata",
      type:"Part-time", experience:"0-1 years", salary:"₹18,000 - ₹28,000 / mo", color:"#f59e0b",
      desc:"Craft engaging blog posts, articles and marketing copy across multiple industries.",
      responsibilities:["Research and write SEO-friendly articles","Edit and proofread content for clarity and tone","Collaborate with marketing team on content calendar","Adapt writing style across different platforms"],
      requirements:["Excellent written English","Basic understanding of SEO","Ability to meet deadlines","Portfolio of writing samples preferred"]
    },
    {
      id:4, title:"Digital Marketing Intern", company:"GrowthEdge Agency", location:"Mumbai",
      type:"Internship", experience:"Fresher", salary:"₹10,000 - ₹15,000 / mo", color:"#ef4444",
      desc:"Support campaigns across social media, email and paid ads while learning core marketing skills.",
      responsibilities:["Assist in running social media campaigns","Track and report campaign performance metrics","Help create marketing content and graphics","Support email marketing initiatives"],
      requirements:["Basic knowledge of digital marketing concepts","Familiarity with social media platforms","Eagerness to learn and take initiative","Currently pursuing or recently completed a degree"]
    },
    {
      id:5, title:"Data Analyst", company:"InsightIQ Analytics", location:"Hyderabad",
      type:"Full-time", experience:"1-3 years", salary:"₹7,00,000 - ₹10,50,000 / yr", color:"#0284c7",
      desc:"Analyze large datasets to uncover trends and support data-driven business decisions.",
      responsibilities:["Clean, process and analyze structured datasets","Build dashboards and reports using BI tools","Present insights to stakeholders clearly","Collaborate with product and business teams"],
      requirements:["Proficiency in SQL and Excel","Experience with Power BI or Tableau","Strong analytical and statistical skills","Knowledge of Python is a plus"]
    },
    {
      id:6, title:"Backend Developer (Node.js)", company:"ServerStack Inc.", location:"Pune",
      type:"Full-time", experience:"2-4 years", salary:"₹8,00,000 - ₹12,00,000 / yr", color:"#16a34a",
      desc:"Design and maintain scalable backend services and RESTful APIs for web applications.",
      responsibilities:["Develop and maintain server-side logic and APIs","Optimize applications for performance and security","Manage database schemas and queries","Collaborate with frontend team on integration"],
      requirements:["Strong experience with Node.js and Express","Knowledge of MongoDB or SQL databases","Understanding of REST API design","Familiarity with Git version control"]
    },
    {
      id:7, title:"Graphic Designer", company:"CanvasCraft Studio", location:"Remote",
      type:"Contract", experience:"1-3 years", salary:"₹4,00,000 - ₹6,50,000 / yr", color:"#db2777",
      desc:"Create compelling visual assets for branding, social media and marketing campaigns.",
      responsibilities:["Design social media graphics and marketing collateral","Maintain brand consistency across assets","Collaborate with marketing on campaign visuals","Prepare files for print and digital use"],
      requirements:["Proficiency in Adobe Photoshop and Illustrator","Strong sense of layout, color and typography","Portfolio showcasing design range","Ability to handle multiple projects at once"]
    },
    {
      id:8, title:"HR Executive", company:"PeopleFirst Solutions", location:"Delhi",
      type:"Full-time", experience:"1-3 years", salary:"₹4,50,000 - ₹6,50,000 / yr", color:"#9333ea",
      desc:"Manage recruitment, onboarding and employee engagement activities for a growing team.",
      responsibilities:["Source and screen candidates for open roles","Coordinate onboarding for new employees","Support employee engagement initiatives","Maintain HR records and documentation"],
      requirements:["Degree in HR or related field","Good communication and interpersonal skills","Basic knowledge of labor laws","Prior HR internship experience preferred"]
    },
    {
      id:9, title:"Finance Associate", company:"CapitalTrust Advisors", location:"Bengaluru",
      type:"Full-time", experience:"2-4 years", salary:"₹6,50,000 - ₹9,50,000 / yr", color:"#059669",
      desc:"Support financial reporting, budgeting and analysis for corporate clients.",
      responsibilities:["Prepare financial statements and reports","Assist with budgeting and forecasting","Analyze financial data for trends and risks","Support audits and compliance checks"],
      requirements:["Degree in Finance, Accounting or related field","Strong Excel and financial modeling skills","Attention to detail and accuracy","Knowledge of accounting standards"]
    },
    {
      id:10, title:"School Curriculum Coordinator", company:"BrightMinds Academy", location:"Chennai",
      type:"Full-time", experience:"3-5 years", salary:"₹5,00,000 - ₹7,50,000 / yr", color:"#d97706",
      desc:"Develop and oversee curriculum design and teacher training programs for K-12 education.",
      responsibilities:["Design and update curriculum frameworks","Train and support teaching staff","Evaluate learning outcomes and adjust programs","Coordinate with department heads on academic goals"],
      requirements:["Degree in Education or related field","Experience in curriculum development","Strong leadership and communication skills","Familiarity with modern teaching methods"]
    },
    {
      id:11, title:"Healthcare Data Coordinator", company:"MediCare Systems", location:"Remote",
      type:"Full-time", experience:"1-3 years", salary:"₹5,50,000 - ₹8,00,000 / yr", color:"#0891b2",
      desc:"Maintain and analyze patient and operational data to support healthcare service delivery.",
      responsibilities:["Manage and update healthcare records systems","Ensure data accuracy and regulatory compliance","Generate reports for clinical operations teams","Coordinate with IT on data system improvements"],
      requirements:["Background in healthcare administration or IT","Knowledge of data privacy regulations","Strong organizational skills","Experience with healthcare software is a plus"]
    },
    {
      id:12, title:"Mobile App Developer (Flutter)", company:"AppForge Labs", location:"Pune",
      type:"Remote", experience:"2-4 years", salary:"₹7,50,000 - ₹11,00,000 / yr", color:"#2563eb",
      desc:"Build cross-platform mobile applications with clean architecture and smooth performance.",
      responsibilities:["Develop features for iOS and Android using Flutter","Integrate APIs and third-party services","Ensure app performance and responsiveness","Debug and resolve production issues"],
      requirements:["Experience with Flutter and Dart","Understanding of mobile UI/UX best practices","Familiarity with REST APIs","Published apps on Play Store/App Store a plus"]
    }
  ];

  const categories = [
    {name:"Technology", count:"120+ jobs", icon:"💻", bg:"#e0f2fe", color:"#0284c7"},
    {name:"Design", count:"65+ jobs", icon:"🎨", bg:"#f3e8ff", color:"#9333ea"},
    {name:"Marketing", count:"80+ jobs", icon:"📣", bg:"#fee2e2", color:"#dc2626"},
    {name:"Finance", count:"55+ jobs", icon:"💰", bg:"#dcfce7", color:"#16a34a"},
    {name:"Education", count:"40+ jobs", icon:"🎓", bg:"#fef3c7", color:"#d97706"},
    {name:"Healthcare", count:"70+ jobs", icon:"🩺", bg:"#cffafe", color:"#0891b2"}
  ];

  /* ---------------- STATE ---------------- */
  let savedIds = JSON.parse(localStorage.getItem("jf_saved_jobs") || "[]");
  let currentFilters = { keyword:"", type:"", location:"", experience:"" };

  /* ---------------- ELEMENTS ---------------- */
  const jobGrid = document.getElementById("jobGrid");
  const savedGrid = document.getElementById("savedGrid");
  const categoryGrid = document.getElementById("categoryGrid");
  const resultsCount = document.getElementById("resultsCount");
  const savedCountNav = document.getElementById("savedCountNav");
  const totalJobsBadge = document.getElementById("totalJobsBadge");
  const filterKeyword = document.getElementById("filterKeyword");
  const filterType = document.getElementById("filterType");
  const filterLocation = document.getElementById("filterLocation");
  const filterExperience = document.getElementById("filterExperience");
  const modalOverlay = document.getElementById("modalOverlay");
  const modalContent = document.getElementById("modalContent");
  const toastWrap = document.getElementById("toastWrap");

  /* ---------------- INIT ---------------- */
  function init(){
    totalJobsBadge.textContent = jobs.length + "+";
    populateLocationFilter();
    renderCategories();
    renderJobs(jobs);
    renderSaved();
    updateSavedCount();
    bindEvents();
  }

  function populateLocationFilter(){
    const locs = [...new Set(jobs.map(j => j.location))].sort();
    locs.forEach(loc=>{
      const opt = document.createElement("option");
      opt.value = loc; opt.textContent = loc;
      filterLocation.appendChild(opt);
    });
  }

  /* ---------------- RENDER JOB CARD ---------------- */
  function createJobCard(job){
    const isSaved = savedIds.includes(job.id);
    const card = document.createElement("div");
    card.className = "job-card";
    card.setAttribute("data-id", job.id);
    card.innerHTML = `
      <div class="job-card-top">
        <div style="display:flex;gap:12px;align-items:flex-start;">
          <div class="job-logo" style="background:${job.color}">${job.company.charAt(0)}</div>
          <div>
            <div class="job-title">${escapeHTML(job.title)}</div>
            <div class="job-company">${escapeHTML(job.company)}</div>
          </div>
        </div>
        <button class="save-btn ${isSaved ? 'saved' : ''}" data-save="${job.id}" aria-label="Save job">${isSaved ? '♥' : '♡'}</button>
      </div>
      <div class="job-meta">
        <span class="tag">${job.type}</span>
        <span class="tag loc">📍 ${job.location}</span>
        <span class="tag exp">🧭 ${job.experience}</span>
      </div>
      <p class="job-desc">${escapeHTML(job.desc)}</p>
      <div class="job-card-bottom">
        <span class="job-salary">${job.salary}</span>
        <button class="btn btn-primary btn-sm" data-view="${job.id}">View Details</button>
      </div>
    `;
    card.addEventListener("click", (e)=>{
      if(e.target.closest("[data-save]")) return;
      openModal(job.id);
    });
    return card;
  }

  function renderJobs(list){
    jobGrid.innerHTML = "";
    if(list.length === 0){
      jobGrid.innerHTML = `
        <div class="no-results">
          <div class="ic">🔎</div>
          <h3>No jobs found</h3>
          <p>Try adjusting your search or filters to see more results.</p>
        </div>`;
      resultsCount.textContent = "Showing 0 jobs";
      return;
    }
    list.forEach(job => jobGrid.appendChild(createJobCard(job)));
    resultsCount.textContent = `Showing ${list.length} job${list.length !== 1 ? 's' : ''}`;
  }

  function renderSaved(){
    savedGrid.innerHTML = "";
    const savedJobs = jobs.filter(j => savedIds.includes(j.id));
    if(savedJobs.length === 0){
      savedGrid.innerHTML = `
        <div class="saved-empty" style="grid-column:1/-1;">
          <div class="ic">🤍</div>
          <h3 style="color:var(--navy);margin-bottom:6px;">No saved jobs yet</h3>
          <p>Tap the heart icon on any job card to save it here for later.</p>
        </div>`;
      return;
    }
    savedJobs.forEach(job => savedGrid.appendChild(createJobCard(job)));
  }

  function renderCategories(){
    categoryGrid.innerHTML = "";
    categories.forEach(cat=>{
      const el = document.createElement("div");
      el.className = "cat-card";
      el.innerHTML = `
        <div class="cat-icon" style="background:${cat.bg};color:${cat.color}">${cat.icon}</div>
        <h4>${cat.name}</h4>
        <span>${cat.count}</span>
      `;
      el.style.cursor = "pointer";
      el.addEventListener("click", ()=>{
        filterKeyword.value = cat.name;
        currentFilters.keyword = cat.name.toLowerCase();
        applyFilters();
        document.getElementById("jobs").scrollIntoView({behavior:"smooth"});
      });
      categoryGrid.appendChild(el);
    });
  }

  /* ---------------- FILTER LOGIC ---------------- */
  function applyFilters(){
    const kw = currentFilters.keyword.trim().toLowerCase();
    const filtered = jobs.filter(job=>{
      const matchesKeyword = !kw ||
        job.title.toLowerCase().includes(kw) ||
        job.company.toLowerCase().includes(kw) ||
        job.desc.toLowerCase().includes(kw) ||
        job.type.toLowerCase().includes(kw);
      const matchesType = !currentFilters.type || job.type === currentFilters.type;
      const matchesLocation = !currentFilters.location || job.location === currentFilters.location;
      const matchesExperience = !currentFilters.experience || job.experience === currentFilters.experience;
      return matchesKeyword && matchesType && matchesLocation && matchesExperience;
    });
    renderJobs(filtered);
  }

  /* ---------------- SAVE / UNSAVE ---------------- */
  function toggleSave(id){
    id = Number(id);
    const idx = savedIds.indexOf(id);
    const job = jobs.find(j => j.id === id);
    if(idx > -1){
      savedIds.splice(idx,1);
      showToast(`Removed "${job.title}" from saved jobs`, "error");
    } else {
      savedIds.push(id);
      showToast(`Saved "${job.title}" to your list`, "success");
    }
    localStorage.setItem("jf_saved_jobs", JSON.stringify(savedIds));
    updateSavedCount();
    // refresh visible hearts without full re-render jank
    document.querySelectorAll(`[data-save="${id}"]`).forEach(btn=>{
      const nowSaved = savedIds.includes(id);
      btn.classList.toggle("saved", nowSaved);
      btn.textContent = nowSaved ? "♥" : "♡";
    });
    renderSaved();
  }

  function updateSavedCount(){
    savedCountNav.textContent = savedIds.length;
  }

  /* ---------------- MODAL ---------------- */
  function openModal(id){
    const job = jobs.find(j => j.id === Number(id));
    if(!job) return;
    const isSaved = savedIds.includes(job.id);
    modalContent.innerHTML = `
      <div class="modal-head">
        <div class="job-logo" style="background:${job.color};width:56px;height:56px;font-size:1.4rem;">${job.company.charAt(0)}</div>
        <div>
          <h2>${escapeHTML(job.title)}</h2>
          <p>${escapeHTML(job.company)} · ${escapeHTML(job.location)}</p>
        </div>
      </div>
      <div class="modal-meta">
        <span class="tag">${job.type}</span>
        <span class="tag loc">📍 ${job.location}</span>
        <span class="tag exp">🧭 ${job.experience}</span>
      </div>
      <div class="modal-salary-row">
        <span style="color:var(--muted);font-size:0.88rem;">Salary</span>
        <strong>${job.salary}</strong>
      </div>
      <div class="modal-block">
        <h4>Job Description</h4>
        <p>${escapeHTML(job.desc)}</p>
      </div>
      <div class="modal-block">
        <h4>Responsibilities</h4>
        <ul>${job.responsibilities.map(r=>`<li>${escapeHTML(r)}</li>`).join("")}</ul>
      </div>
      <div class="modal-block">
        <h4>Requirements</h4>
        <ul>${job.requirements.map(r=>`<li>${escapeHTML(r)}</li>`).join("")}</ul>
      </div>
      <div class="modal-actions">
        <button class="btn btn-primary btn-block" id="modalApplyBtn">Apply Now</button>
        <button class="btn btn-outline" id="modalSaveBtn">${isSaved ? '♥ Saved' : '♡ Save'}</button>
      </div>
    `;
    modalOverlay.classList.add("active");
    document.body.style.overflow = "hidden";

    document.getElementById("modalApplyBtn").addEventListener("click", ()=>{
      showToast(`Application submitted for "${job.title}"! 🎉`, "success");
      closeModal();
    });
    document.getElementById("modalSaveBtn").addEventListener("click", (e)=>{
      toggleSave(job.id);
      const nowSaved = savedIds.includes(job.id);
      e.target.textContent = nowSaved ? "♥ Saved" : "♡ Save";
    });
  }

  function closeModal(){
    modalOverlay.classList.remove("active");
    document.body.style.overflow = "";
  }

  /* ---------------- TOAST ---------------- */
  function showToast(message, type){
    const toast = document.createElement("div");
    toast.className = `toast ${type || ""}`;
    toast.textContent = message;
    toastWrap.appendChild(toast);
    setTimeout(()=> toast.remove(), 2800);
  }

  /* ---------------- UTILS ---------------- */
  function escapeHTML(str){
    const div = document.createElement("div");
    div.textContent = str;
    return div.innerHTML;
  }

  /* ---------------- EVENTS ---------------- */
  function bindEvents(){
    // Hamburger menu
    const hamburger = document.getElementById("hamburger");
    const navLinks = document.getElementById("navLinks");
    hamburger.addEventListener("click", ()=>{
      hamburger.classList.toggle("open");
      navLinks.classList.toggle("open");
    });
    navLinks.querySelectorAll("a").forEach(link=>{
      link.addEventListener("click", ()=>{
        hamburger.classList.remove("open");
        navLinks.classList.remove("open");
        navLinks.querySelectorAll("a").forEach(a=>a.classList.remove("active"));
        link.classList.add("active");
      });
    });

    // Hero search form
    document.getElementById("heroSearchForm").addEventListener("submit", (e)=>{
      e.preventDefault();
      const kw = document.getElementById("heroKeyword").value.trim();
      const loc = document.getElementById("heroLocation").value.trim();
      if(!kw && !loc){
        showToast("Please enter a job title or location to search", "error");
        return;
      }
      filterKeyword.value = kw;
      currentFilters.keyword = kw;
      if(loc){
        const matchedOption = [...filterLocation.options].find(
          o => o.value.toLowerCase() === loc.toLowerCase()
        );
        if(matchedOption){
          filterLocation.value = matchedOption.value;
          currentFilters.location = matchedOption.value;
        } else {
          currentFilters.location = "";
          filterLocation.value = "";
        }
      }
      applyFilters();
      document.getElementById("jobs").scrollIntoView({behavior:"smooth"});
      showToast("Search results updated", "success");
    });

    // Filter bar events
    filterKeyword.addEventListener("input", (e)=>{
      currentFilters.keyword = e.target.value;
      applyFilters();
    });
    filterType.addEventListener("change", (e)=>{
      currentFilters.type = e.target.value;
      applyFilters();
    });
    filterLocation.addEventListener("change", (e)=>{
      currentFilters.location = e.target.value;
      applyFilters();
    });
    filterExperience.addEventListener("change", (e)=>{
      currentFilters.experience = e.target.value;
      applyFilters();
    });

    document.getElementById("resetFilters").addEventListener("click", resetAllFilters);
    document.getElementById("clearAllLink").addEventListener("click", (e)=>{
      e.preventDefault();
      resetAllFilters();
    });

    function resetAllFilters(){
      currentFilters = { keyword:"", type:"", location:"", experience:"" };
      filterKeyword.value = "";
      filterType.value = "";
      filterLocation.value = "";
      filterExperience.value = "";
      renderJobs(jobs);
      showToast("Filters cleared", "success");
    }

    // Delegated click for save buttons and view-details buttons
    document.addEventListener("click", (e)=>{
      const saveBtn = e.target.closest("[data-save]");
      if(saveBtn){
        e.stopPropagation();
        toggleSave(saveBtn.getAttribute("data-save"));
        return;
      }
      const viewBtn = e.target.closest("[data-view]");
      if(viewBtn){
        e.stopPropagation();
        openModal(viewBtn.getAttribute("data-view"));
      }
    });

    // Modal close
    document.getElementById("modalClose").addEventListener("click", closeModal);
    modalOverlay.addEventListener("click", (e)=>{
      if(e.target === modalOverlay) closeModal();
    });
    document.addEventListener("keydown", (e)=>{
      if(e.key === "Escape") closeModal();
    });
  }

  init();
})();
</script>
